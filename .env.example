# Токен вашего Telegram бота от @BotFather
BOT_TOKEN=8834073745:AAFEjQfP9XQWEQMHedaVrycY0soLD-e1-7Y

# Логин от личного кабинета mystat.itstep.org
MYSTAT_USERNAME=grudi_ms97

# Пароль от личного кабинета mystat.itstep.org
MYSTAT_PASSWORD=your_password_here

# Ваш Telegram User ID (для защиты бота от посторонних пользователей)
# Узнать свой ID можно в ботах @userinfobot или @myidbot
MY_TELEGRAM_ID=1186053117

# Включение встроенного само-пинга (true - включен, false - выключен)
# Поставьте false, если настраиваете внешний пинг через cron-job.org
ENABLE_SELF_PINGER=true

# Интервал само-пинга в минутах (по умолчанию 9 минут)
PING_INTERVAL_MINUTES=9

# Порт для локального запуска (на Render.com устанавливается автоматически)
PORT=3000

# Публичный URL приложения (на Render.com переменная RENDER_EXTERNAL_URL подставляется автоматически!)
APP_URL=http://localhost:3000
