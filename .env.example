# Токен вашего Telegram бота от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRstuVWXyz)
BOT_TOKEN=your_telegram_bot_token_here

# Порт для локального запуска (на Render.com устанавливается автоматически)
PORT=3000

# Публичный URL приложения (на Render.com переменная RENDER_EXTERNAL_URL подставляется автоматически!)
# Например: https://mystat-helper.onrender.com
APP_URL=http://localhost:3000

# Интервал для предотвращения засыпания Render.com (в минутах, по умолчанию 9)
PING_INTERVAL_MINUTES=9
